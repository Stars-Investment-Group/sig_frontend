# Configuration du frontend SIG.
#
# Copier en `.env.local` (ignore par git) et ajuster. Vite n'expose au
# navigateur que les variables prefixees `VITE_`.

# Base de l'API. Le backend n'a **aucun prefixe global** : `/api` ne sert que
# Swagger, les routes sont a la racine (`/countries`, `/macro-data`...).
#   developpement : http://localhost:3000
#   OVH           : https://api.<domaine>   (a confirmer avec l'equipe backend)
VITE_API_URL=http://localhost:3000

# Interrupteur de source.
#
# Tant qu'il ne vaut pas `true`, l'application tourne sur les donnees statiques
# de `client/src/data/`. C'est ce qui permet de brancher l'API module par
# module sans jamais livrer une page vide : la regle de l'audit est que la
# donnee reelle devienne la source primaire **et que les mocks restent le
# repli**.
VITE_USE_API=false
